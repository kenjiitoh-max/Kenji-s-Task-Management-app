{
  "expo": {
    "name": "Kenji-s-Task-Management-app",
    "slug": "Kenji-s-Task-Management-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "taskapp",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["@kingstinct/react-native-healthkit", { "NSHealthShareUsageDescription": "体重・体脂肪をヘルスケアから読み取り、体重管理カテゴリに記録します", "NSHealthUpdateUsageDescription": "このアプリはヘルスケアへの書き込みは行いません" }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kenjiitoh.taskapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B2166",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kenjiitoh.taskapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
